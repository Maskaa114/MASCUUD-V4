# --- Mode -------------------------------------------------------------
# testnet (default) or live. LIVE also requires LIVE_TRADING_CONFIRM below.
MASCUUD_MODE=testnet
# true = orders go to /api/v3/order/test (validated, never filled)
DRY_RUN=true
# Must be exactly this string to allow MASCUUD_MODE=live
LIVE_TRADING_CONFIRM=

# --- Binance Spot Testnet credentials (https://testnet.binance.vision) -
# Never commit real keys. Never paste them into chats.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Strategy / scanner -----------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
INTERVAL=5m
QUOTE_ASSET=USDT

# --- Risk ---------------------------------------------------------------
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_PCT=20
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0

# --- Storage / alerts ---------------------------------------------------
DB_PATH=mascuud.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
